#!/bin/sh
# Push-before gate (docs/rules/process/common/development-flow.md, "security"). Install: sh scripts/setup-dev-env.sh
# Git passes <remote name> <url> as arguments and one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
#   - a deletion (local sha all zeros) has nothing to scan and passes;
#   - anything but the checked-out commit is refused, so that what is scanned and read is what is pushed (the pushed object
#     itself is compared with HEAD, not what it points to: an annotated tag object is not a commit);
#   - only refs/heads/* may be pushed to (a branch deletion passes): the message of a tag, a note and any other non-branch
#     object is not scanned, and the object reaches the destination even if the ref update is refused afterwards;
#   - the content review record (git config kaninabe.contentReviewed) must name that commit: it is written after the
#     push has been read for publication, and must be written again after any new commit;
#   - every push of a tag is refused, a deletion included (tags are made and deleted by the tag workflow only);
#   - then the gate runs, always in words mode (no way to ask for general mode here), over the commits that the destination does
#     not itself say it has (scripts/push-range.sh prints exactly that set, which is also what the content reviewer reads). The word list is $SCAN_WORDS_FILE or git config kaninabe.scanWords; the owner is $SCAN_OWNER or
#     kaninabe.scanOwner. Skipping this hook (--no-verify, no hooksPath) is forbidden by rule; it cannot be prevented.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
head=$(git rev-parse --verify -q 'HEAD^{commit}' || true)
short() { printf '%s' "$1" | cut -c1-8; }
refuse() { echo "pre-push: $*" >&2; exit 1; }

pushing=0
remote_shas=
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  case "$local_ref $remote_ref" in
    *refs/tags/*) refuse "refusing to push a tag ($remote_ref): tags are created and deleted only by the tag workflow, and a tag message is not scanned" ;;
  esac
  case $remote_ref in
    refs/heads/?*) ;;
    *) refuse "refusing to push to $remote_ref: only branches (refs/heads/*) are pushed; tags, notes, remote-tracking and pull request refs can carry objects that no scan has read" ;;
  esac
  case $local_sha in *[!0]*) ;; *) continue ;; esac
  # The object itself, not what it points to: an annotated tag object peels to a commit and would pass as HEAD.
  if [ -z "$head" ] || [ "$local_sha" != "$head" ]; then
    refuse "refusing to push $(short "$local_sha"): it is not the checked-out commit; check it out first"
  fi
  reviewed=$(git config --get kaninabe.contentReviewed || true)
  if [ "$reviewed" != "$head" ]; then
    echo "pre-push: the content review record (kaninabe.contentReviewed) does not name $(short "$head")" >&2
    refuse "have the push read for publication, then run: git config kaninabe.contentReviewed $head"
  fi
  case $remote_sha in *[!0]*) remote_shas="$remote_shas $remote_sha" ;; esac
  pushing=1
done
[ "$pushing" = 1 ] || exit 0

if [ -z "${SCAN_WORDS_FILE:-}" ]; then
  w=$(git config --get kaninabe.scanWords || true)
  [ -z "$w" ] || SCAN_WORDS_FILE=$w
fi
if [ -z "${SCAN_OWNER:-}" ]; then
  o=$(git config --get kaninabe.scanOwner || true)
  [ -z "$o" ] || SCAN_OWNER=$o
fi
[ -z "${SCAN_WORDS_FILE:-}" ] || export SCAN_WORDS_FILE
[ -z "${SCAN_OWNER:-}" ] || export SCAN_OWNER

# Which commits: the ones the destination does not itself say it has (push-range.sh asks it now, with the URL git
# passes as $2 and the remote shas of the refs being pushed; remote-tracking refs are never consulted). If the destination
# cannot be asked, or the history cannot be read to the end, push-range.sh stops with a reason and so does the push.
url=${2:-}
[ -n "$url" ] || refuse "git did not pass the URL of the destination"
# shellcheck disable=SC2086
range_args=$(sh "$here/../scripts/push-range.sh" --gate-args --head "$head" "$url" $remote_shas) || exit 1
# shellcheck disable=SC2086
exec sh "$here/../scripts/push-gate.sh" --mode words --head "$head" $range_args
