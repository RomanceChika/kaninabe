{
  "name": "@kaninabe/spec-tools",
  "version": "0.1.0",
  "private": true,
  "description": "仕様の検証器・生成器・CLI とそのテスト。ワークスペースには入れない(ADR-0013。検査器のツールチェーンを製品のビルドに混ぜない)ので、自分の lockfile で `npm ci` する。ルートの scripts が同名で取り次ぐ。",
  "type": "module",
  "scripts": {
    "verify": "node ../../framework/runtime/scripts/check-node.mjs && node ../../framework/runtime/scripts/check-dist-fresh.mjs && tsx cli/verify-docs.ts",
    "book": "tsx cli/generate-book.ts",
    "book:open": "tsx cli/serve-book.ts",
    "book:notice:full": "BOOK_NOTICE_FULL=1 vitest run --config vitest.heavy.config.ts __tests__/dev-repo/unit/generate/book-entry-notice.test.ts",
    "generate": "node ../../framework/runtime/scripts/check-dist-fresh.mjs && tsx cli/generate-docs.ts",
    "generate:check": "node ../../framework/runtime/scripts/check-dist-fresh.mjs && tsx cli/generate-docs.ts --check",
    "check:migrations": "tsx cli/check-migrations.ts",
    "deps:check": "tsx cli/deps-check.ts",
    "deps:check:offline": "node --import ./cli/ts-js-resolve.mjs cli/deps-check-offline.ts",
    "deps:check:gate": "node --import ./cli/ts-js-resolve.mjs cli/deps-check.ts --ship-gate",
    "check:formal": "tsx cli/check-formal.ts",
    "spec:diff": "tsx cli/spec-diff.ts",
    "samples:db": "node ../../framework/runtime/scripts/check-dist-fresh.mjs && tsx cli/samples-db.ts",
    "prove:api-views": "tsx cli/prove-api-viewdef.mjs",
    "prove:checks": "tsx cli/prove-check-canonical.mjs",
    "test": "sh -c 'if [ \"$#\" -ne 0 ]; then echo \"test: 引数は受け取りません(-- の後ろの引数は && の後ろの組にだけ付くため。絞るときは組の設定を --config で名指して vitest を直に呼ぶ)\" >&2; exit 2; fi; vitest run --config vitest.config.ts && vitest run --config vitest.heavy.config.ts' test",
    "test:dev-repo": "sh -c 'if [ \"$#\" -ne 0 ]; then echo \"test:dev-repo: 引数は受け取りません(範囲は置き場の丸ごとと、実物の製品の木を読むテストの閉じた表。読み手の表は gates の readers 表)\" >&2; exit 2; fi; vitest run --config vitest.config.ts __tests__/dev-repo __tests__/guarantees/session-lifecycle.test.ts && vitest run --config vitest.heavy.config.ts __tests__/dev-repo' test:dev-repo",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "node ../../framework/runtime/scripts/check-dist-fresh.mjs && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@kaninabe/adapter-postgrest": "file:../../framework/adapters/postgrest",
    "@kaninabe/adapter-supabase-session": "file:../../framework/adapters/supabase-session",
    "@kaninabe/lint-config": "file:../../framework/lint-config",
    "@kaninabe/runtime": "file:../../framework/runtime",
    "@types/mdast": "4.0.4",
    "@types/node": "22.19.11",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "5.2.4",
    "eslint": "^9.39.5",
    "fast-check": "4.10.0",
    "js-yaml": "4.3.2",
    "pg": "^8.23.0",
    "remark-parse": "11.0.0",
    "server-only": "^0.0.1",
    "tsx": "4.22.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "unified": "11.0.5",
    "vitest": "^4.1.12",
    "vue": "3.5.44",
    "z3-solver": "5.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
