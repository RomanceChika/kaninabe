  },
  "scripts": {
    "lint": "eslint --max-warnings 0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.66.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0"
  },
  "devDependencies": {
    "eslint-plugin-boundaries": "^7.1.0"
  },
  "peerDependencies": {
    "eslint": "^9.39.5"
  }
